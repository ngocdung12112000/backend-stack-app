{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/products/{**catch-all}" },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-User-Roles" },
          { "RequestHeaderRemove": "X-User-Permissions" }
        ]
      },
      "docs-catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/docs/catalog/swagger.json" },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001/" }
        }
      }
    }
  }
}
