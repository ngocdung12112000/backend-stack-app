{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "catalog-brands": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/brands/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "catalog-admin-products": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/products/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "catalog-admin-categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/categories/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "catalog-admin-brands": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/brands/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "docs-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/docs/catalog/swagger.json"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "identity-jwks": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/jwks.json"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "identity-addresses": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/addresses/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "identity-admin-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/admin/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Transforms": [
          {
            "RequestHeaderRemove": "X-User-Id"
          },
          {
            "RequestHeaderRemove": "X-User-Roles"
          },
          {
            "RequestHeaderRemove": "X-User-Permissions"
          }
        ]
      },
      "docs-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/docs/identity/swagger.json"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "stackshop-identity",
    "Audience": "stackshop-api",
    "JwksUrl": "http://localhost:5002/.well-known/jwks.json"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
