{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "Catalog": {
    "ProductCacheMinutes": 10,
    "ProductCacheJitterSeconds": 60,
    "CategoryTreeCacheMinutes": 60,
    "Currency": "USD"
  },
  "Mongo": {
    "Database": "catalog"
  },
  "AllowedHosts": "*"
}
