{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.stackshop.local/events/identity.password-reset-requested.v1.schema.json",
  "title": "identity.password-reset-requested.v1",
  "description": "Published after forgot-password for an existing active account. Carries a one-time secret: never log the payload.",
  "type": "object",
  "required": [
    "id",
    "type",
    "source",
    "occurredAt",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Message id; consumers dedupe on it (Inbox)."
    },
    "type": {
      "const": "identity.password-reset-requested.v1"
    },
    "source": {
      "const": "identity"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "userId",
        "email",
        "resetToken",
        "expiresAt"
      ],
      "additionalProperties": true,
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "resetToken": {
          "type": "string",
          "description": "One-time token; sensitive."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
